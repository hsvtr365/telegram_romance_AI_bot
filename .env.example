APP_NAME=heartlink-bot
APP_ENV=local
APP_PORT=8080

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_UPDATES=message
TELEGRAM_POLL_TIMEOUT_SEC=30
TELEGRAM_POLL_LIMIT=50

OLLAMA_ENDPOINT_01_BASE_URL=https://gitlab.swempire.co.kr/ollama
OLLAMA_ENDPOINT_01_MODEL=gemma4-heretic:q4km
OLLAMA_ENDPOINT_02_BASE_URL=http://127.0.0.1:11434
OLLAMA_ENDPOINT_02_MODEL=gemma4-26b-heretic-q4km:latest
OLLAMA_BASE_URL=https://gitlab.swempire.co.kr/ollama
OLLAMA_MODEL=gemma4-heretic:q4km
OLLAMA_HEALTHCHECK_INTERVAL_SEC=1800
OLLAMA_TIMEOUT_SEC=35
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.9
OLLAMA_TOP_P=0.9

POSTGRES_DSN=postgres://username:password@host:5432/dbname?sslmode=disable
REDIS_URL=redis://username:password@host:6379/0

RECENT_TURN_LIMIT=14
SUMMARY_TRIGGER_MESSAGES=10
SESSION_LOCK_TTL_SEC=20
CHAT_COOLDOWN_SEC=2
RESPONSE_MAX_CHARS=0
CHAT_PHASE_RULES_PATH=configs/conversation_phase_rules.json
CHAT_STATE_REVIEW_ENABLED=true
CHAT_STATE_REVIEW_MODEL=gemma3:2b
CHAT_STATE_REVIEW_BASE_URL=https://gitlab.swempire.co.kr/ollama
CHAT_STATE_REVIEW_TIMEOUT_MS=1200
CHAT_STATE_REVIEW_WORKERS=2
CHAT_STATE_REVIEW_QUEUE_SIZE=32
CHAT_MEMORY_SLOT_ENABLED=false
CHAT_MEMORY_SLOT_MODEL=gemma3:2b
CHAT_MEMORY_SLOT_MIN_CHARS=16
CHAT_MEMORY_SLOT_SYNC_TIMEOUT_MS=700
CHAT_MEMORY_SLOT_ASYNC_TIMEOUT_MS=6000
CHAT_MEMORY_SLOT_WORKERS=2
CHAT_MEMORY_SLOT_QUEUE_SIZE=32

PROACTIVE_ENABLED=true
PROACTIVE_SCAN_INTERVAL_SEC=60
PROACTIVE_REMINDER_SCAN_INTERVAL_SEC=5
PROACTIVE_FEEDBACK_INTERVAL_SEC=300
PROACTIVE_REPLY_WINDOW_HOURS=24
PROACTIVE_DEFAULT_TIMEZONE=Asia/Seoul
PROACTIVE_ALLOWED_START_HOUR=11
PROACTIVE_ALLOWED_END_HOUR=22
PROACTIVE_RECONNECT_IDLE_HOURS=72
PROACTIVE_EVENT_LOOKAHEAD_HOURS=3
PROACTIVE_EVENT_FOLLOWUP_GRACE_HOURS=3
PROACTIVE_MAX_CANDIDATES_PER_SCAN=100
PROACTIVE_REMINDER_MODEL=gemma3:2b

HOLIDAY_SYNC_ENABLED=true
HOLIDAY_API_SERVICE_KEY=your-data-go-kr-service-key
HOLIDAY_API_BASE_URL=http://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService
HOLIDAY_SYNC_INTERVAL_HOURS=24
HOLIDAY_LOOKAHEAD_DAYS=7
HOLIDAY_PROMPT_TODAY_PERCENT=40
HOLIDAY_PROMPT_UPCOMING_PERCENT=25
