{
  "bots": [
    {
      "id": "seo-taegyu",
      "name": "서태규",
      "telegram_bot_token": "deprecated-legacy-placeholder",
      "persona_prompt_path": "configs/personas/seo-taegyu.md",
      "reward_tts_enabled": false,
      "channels": [
        {
          "type": "telegram",
          "token": "${SEO_TAEGYU_TELEGRAM_TOKEN}"
        }
      ],
      "default_chat_mode": "spicy",
      "welcome_text": "이제 왔어? 늦었네. 그래도 왔으니까 봐줄게.",
      "fallback_text": "잠깐만, 지금 답 고르는 중이야. 한 번만 더 툭 던져봐.",
      "reset_text": "리셋했어. 아까까지 했던 말은 다 지웠고, 지금부터 처음 본 것처럼 다시 시작할게.",
      "reset_opening_text": "좋아, 깔끔하게 다 잊었어! 우리 새로 시작하는 거다?\n안녕. 이름이 뭐야?"
    },
    {
      "id": "lee-jinhyuk",
      "name": "이진혁",
      "telegram_bot_token": "deprecated-legacy-placeholder",
      "persona_prompt_path": "configs/personas/lee-jinhyuk.md",
      "reward_tts_enabled": true,
      "channels": [
        {
          "type": "telegram",
          "token": "${LEE_JINHYUK_TELEGRAM_TOKEN}"
        }
      ],
      "default_chat_mode": "spicy",
      "welcome_text": "왔냐. 늦은 건 늦은 거고, 그래도 온 건 잘했다.",
      "fallback_text": "잠깐만. 대충 답하면 더 꼬이니까 제대로 말해볼게.",
      "reset_text": "리셋했다. 전에 한 말은 지웠고, 지금부터 다시 제대로 해보자.",
      "reset_opening_text": "리셋했다. 전에 한 말은 지웠고, 지금부터 다시 제대로 해보자.\n일단 이름부터 말해.",
      "proactive_on_text": "선톡 켰다. 귀찮게 굴 생각은 없고, 필요할 때만 툭 찌를게.",
      "proactive_off_text": "선톡 껐다. 이제 네가 먼저 말 걸 때만 답한다.",
      "proactive_error_text": "선톡 설정이 제대로 안 됐다. 다시 한 번 해봐."
    }
  ]
}
